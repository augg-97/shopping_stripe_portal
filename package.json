{
  "name": "shopping_stripe_portal",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "format": "eslint . --fix --config ./eslint.config.ts",
    "lint": "eslint . --config ./eslint.config.ts",
    "lint-staged": "lint-staged",
    "dev:no-watch": "nest start",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "start:dev": "cross-env NODE_ENV=production nest start --watch",
    "prebuild": "rimraf ./dist",
    "build": "nest build",
    "start": "node dist/main",
    "test:integration": "jest --config ./jest.integration.config.json --no-cache --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migration": "prisma migrate",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org sps-l1 --project sps-portal ./dist && sentry-cli sourcemaps upload --org sps-l1 --project sps-portal ./dist"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "**/*.ts": [
      "npm run lint"
    ],
    "**/*.json": [
      "prettier --write"
    ],
    "**/*.prisma": [
      "prisma format",
      "prisma validate"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@casl/ability": "^6.7.3",
    "@casl/prisma": "^1.5.1",
    "@grpc/grpc-js": "^1.13.4",
    "@nestjs/common": "^11.1.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.203.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@prisma/client": "^6.12.0",
    "@sentry/cli": "^2.51.0",
    "@sentry/nestjs": "^10.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.6.1",
    "jiti": "^2.4.2",
    "mime-types": "^3.0.1",
    "nodemailer": "^7.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.15",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.1.2",
    "only-allow": "^1.2.1",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
